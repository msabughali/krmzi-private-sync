# ---------- Source site ----------
SOURCE_BASE_URL=https://krmzy.com
SOURCE_LIST_PATH=/
MAX_EPISODES_PER_RUN=50
MAX_LIST_PAGES=5
NAVIGATION_TIMEOUT_MS=60000

# ---------- Crawler behavior ----------
HEADLESS=true
CRAWLER_RETRIES=3
MIN_DELAY_MS=400
MAX_DELAY_MS=900

# ---------- Optional remote sync (leave blank to disable) ----------
# TARGET_SYNC_ENDPOINT=https://your-private-api.example.com/internal/episodes/sync
# TARGET_SYNC_TOKEN=replace-with-long-random-token
SYNC_TIMEOUT_MS=20000

# ---------- Runtime / storage ----------
STATE_FILE_PATH=/app/data/state.json
EPISODES_FILE_PATH=/app/data/episodes.json
INTERVAL_MINUTES=30
DRY_RUN=false
LOG_LEVEL=info

# ---------- Web UI ----------
WEB_PORT=8787
