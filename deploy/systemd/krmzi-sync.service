[Unit]
Description=KRMZI private episode sync
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/krmzi-private-sync
EnvironmentFile=/opt/krmzi-private-sync/.env
ExecStart=/usr/bin/node /opt/krmzi-private-sync/src/index.js --once
User=www-data
Group=www-data
Nice=10

[Install]
WantedBy=multi-user.target
