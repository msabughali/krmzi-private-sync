# Keep image lean — exclude everything not needed at runtime
.git
.gitignore
.github
.vscode
.idea
.DS_Store

# Dependencies are installed inside the image
node_modules

# Env files stay outside the image (Coolify injects env vars at runtime)
.env
.env.*
!.env.example

# Runtime data lives on a mounted volume; only the seed snapshots are bundled
data
!data/episodes.json
!data/series.json
!data/state.json

# Repo-only tooling / docs — only the entrypoint script is needed in the image
README.md
scripts
!scripts/docker-entrypoint.sh

# Editor / OS cruft
*.swp
*.swo
*.log

# Local-only docker compose files (override.yml etc.) should not be baked in
docker-compose.override.yml
docker-compose.override.yaml
